# Variáveis do transcritor — modelo. Só NOMES; nunca valores reais.
#
# O arquivo REAL é `transcritor.env`, ao lado deste, e vive NA MÁQUINA do
# transcritor. Está no .gitignore e nunca entra no repo.
#
# A lista completa, com padrões e o que cada uma faz, está em `agent/README.md`.

# Onde fica o backend da videoconferência.
TRANSCRITOR_API=https://video.pbltools.io

# O MESMO segredo do `NODE_SECRET` em /opt/bwl/app/backend.env, no servidor da
# aula. Sem ele o backend responde 401 a tudo — e o sintoma é uma transcrição
# que nunca aparece, não um erro na tela.
NODE_SECRET=

# whisper (nesta máquina) ou deepgram (API). Nome desconhecido ERRA no boot, de
# propósito: um erro de digitação que escolhesse o outro motor em silêncio
# trocaria o custo do mês sem ninguém notar.
ASR_ENGINE=whisper

# ── whisper ─────────────────────────────────────────────────────────────────
ASR_MODELO=large-v3-turbo
ASR_DISPOSITIVO=cuda
ASR_COMPUTE=int8_float16
ASR_IDIOMA=pt
# Em máquina sem GPU: ASR_DISPOSITIVO=cpu e ASR_COMPUTE=int8

# ── deepgram ────────────────────────────────────────────────────────────────
# ASR_MODELO=nova-3
# ASR_IDIOMA=pt-BR
DEEPGRAM_API_KEY=

# ── Ritmo e limites ─────────────────────────────────────────────────────────
TRANSCRITOR_INTERVALO=15
TRANSCRITOR_FILA=64
TRANSCRITOR_TRABALHADORES=1
# Energia (RMS 0..1) acima da qual se considera que há voz. Ajustar exige medir
# com uma sala de verdade: baixo demais, o ventilador abre fala e o modelo
# alucina; alto demais, quem fala baixo desaparece da transcrição — e desaparece
# em silêncio, que é o pior dos dois.
TRANSCRITOR_LIMIAR_DE_VOZ=0.012
