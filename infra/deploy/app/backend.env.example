# Variáveis do backend (FastAPI) — modelo.
#
# O arquivo REAL é `backend.env`, ao lado deste, e vive NO SERVIDOR
# (Lightsail, /opt/bwl/app/backend.env). O `docker-compose.yml` o carrega com
# `env_file: ./backend.env`. Ele está no .gitignore e nunca entra no repo.
#
# ## Por que este modelo existe
#
# Até 2026-10-22 não havia nenhum. A cópia local de `backend.env` era de agosto
# e não tinha NENHUMA das chaves da integração OpenPBL que a produção já usava
# — quem olhasse por aqui concluiria que o serviço roda sem elas. Um modelo com
# os NOMES (e só eles) é a diferença entre saber o que falta e descobrir pelo
# sintoma.
#
# Mantenha este arquivo em dia quando acrescentar uma variável em
# `backend/app/config.py`. Valores aqui são placeholders, nunca os reais.

# ── Infraestrutura ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://rtc.pbltools.io
LIVEKIT_HOST_URL=wss://rtc.pbltools.io
RECORDING_VIEW_BASE_URL=https://video.pbltools.io
CORS_ORIGINS=https://app.openpbl.ai
NODE_SECRET=

# ── Aula OpenPBL ao vivo (API legada: class-code, liberação, chat) ──────────
OPENPBL_INTEGRATION_URL=https://integration.openpbl.ai
OPENPBL_INTEGRATION_APIKEY=
OPENPBL_CHAT_URL=https://chat.openpbl.ai
OPENPBL_CHAT_USER=
OPENPBL_CHAT_PASS=

# Autoriza o POST /realtime/.../release no Scorm (push SSE da liberação).
# DEVE ser igual ao REALTIME_RELEASE_TOKEN da task def do openpbl.Scorm.
SCORM_REALTIME_RELEASE_TOKEN=

# ── Avaliação de desempenho na plenária ─────────────────────────────────────
#
# A nota que o facilitador dá no menu de contexto da câmera vai para o ELEARN
# (Rise), não para `OPENPBL_INTEGRATION_URL`: aquela é a API legada, e o pacote
# de desempenho novo não mora lá. Mandar para o lugar errado NÃO daria erro — a
# nota simplesmente não apareceria para o aluno.
#
# Sem o token a rota `/openpbl/avaliar` devolve 503 e o menu não grava.
#
# O token é o de uma conta de serviço no elearn (mesmo tipo que o CoreService
# usa, em `RISE_API_TOKEN`). Vale a pena ser um token PRÓPRIO desta aplicação:
# compartilhar com o CoreService faz um vazamento valer pelos dois.
OPENPBL_RISE_URL=https://elearnapp.openpbl.ai/api
OPENPBL_RISE_TOKEN=
